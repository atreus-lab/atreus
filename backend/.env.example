# Atreus Backend — Testnet
NEXT_PUBLIC_CONTRACT_ID=CBJ3QG3FAT5TZVI75ADW3MPIGVPFR5M5BPQJH4AE5U7RS2ZW4VL5Z32P
NEXT_PUBLIC_VERIFIER_CONTRACT_ID=CA4O6LAKKMVD6MRMZXUU3AUMCNDRTNPQNBCP4BA36NYEJNKGFJDVW4AK
NEXT_PUBLIC_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
ATTESTER_SECRET_KEY=
RELAYER_SECRET_KEY=
BATCH_CREATOR_SECRET_KEY=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
PORT=3001
FRONTEND_URL=http://localhost:3000
# DKIM email ownership verification (issue #77)
EMAIL_VERIFY_TO=verify@atreus.local
# EMAIL_CHALLENGE_TTL_MS=86400000
# EMAIL_VERIFIED_TTL_MS=3600000
LOG_LEVEL=info
# HMAC-SHA256 secret used to sign webhook payloads (X-Atreus-Signature header).
# Receivers verify deliveries by recomputing the HMAC with this shared secret.
WEBHOOK_SECRET=

# --- Attestation batching (see docs/batch-attestation.md) -------------------
# Opt-in. When true, verified attestations are queued and written with
# VerifierContract.attest_batch, collapsing up to 3N attester transactions into
# one. Left off, the per-claim path runs exactly as before.
ATTESTATION_BATCHING=false
# Hard ceiling on claims per batch transaction, enforced independently of age.
# Validated on testnet: 100 both simulates and submits successfully. Lower it if
# you want a smaller blast radius — batches are atomic, so at 100 one rejected
# claim reverts 99 others. Fees are ~flat per claim regardless of batch size, so
# a bigger cap buys fewer transactions, not cheaper ones.
ATTESTATION_BATCH_SIZE_CAP=100
# Longest an attestation may sit queued before its batch is flushed. A recipient
# cannot call claim_link until their attestation lands, so this is the latency
# they absorb. 10s is a starting point, not a measured tolerance.
ATTESTATION_BATCH_LATENCY_MS=10000
